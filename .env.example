# Consigliere Environment Variables
# Copy this file to .env and fill in the values

# ── Required ─────────────────────────────────────────────────────────────────

# IMPORTANT: In Docker, use 'db' as the hostname (the service name in docker-compose).
# For local dev (no Docker), use 'localhost'.
DATABASE_URL=postgresql://user:password@db:5432/consigliere

# Generate a secure random key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here

# Generate a 32-byte URL-safe base64 key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-encryption-key-here

# ── LLM Configuration (LiteLLM supports 100+ models) ───────────────────────────
# See full model list: https://models.litellm.ai/
MODEL_NAME=openai/gpt-4o

# Provider API Keys (at least one required based on your model)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=consigliere

# ── pgAdmin (optional) ───────────────────────────────────────────────────────
PGADMIN_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=admin
